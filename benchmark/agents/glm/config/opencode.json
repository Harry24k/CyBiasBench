{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "provider": {
    "litellm-glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM GLM Proxy",
      "options": {
        "baseURL": "http://metrics-proxy:4000/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "glm-5.1": {
          "id": "glm-5.1",
          "name": "GLM 5.1",
          "family": "glm",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5": {
          "id": "glm-5",
          "name": "GLM 5",
          "family": "glm",
          "reasoning": true,
          "tool_call": true
        },
        "glm-4.7": {
          "id": "glm-4.7",
          "name": "GLM 4.7",
          "family": "glm",
          "reasoning": true,
          "tool_call": true
        },
        "glm-4.5-air": {
          "id": "glm-4.5-air",
          "name": "GLM 4.5 Air",
          "family": "glm",
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  }
}
