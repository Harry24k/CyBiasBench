# ===========================================
# AI Agent Attack Automation - Environment
# ===========================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# OpenAI (Codex CLI)
OPENAI_API_KEY=sk-...

# Anthropic (Claude Code)
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini CLI)
GOOGLE_API_KEY=***

# Zhipu AI (GLM / GLM-5.1)
# OpenAI-compatible base URL for Z.ai / BigModel API (open.bigmodel.cn alias also works)
GLM_API_KEY=***
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Moonshot AI (Kimi Code CLI)
KIMI_API_KEY=***

# ===========================================
# Optional Settings
# ===========================================

# Default output mode: report (markdown) or struct (jsonl)
OUTPUT_MODE=report
